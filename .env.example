# Copia este archivo a .env.local y rellena lo que tengas. NADA de aquí es obligatorio para correr la app:
# el grafo viene versionado en data/atlas.json y sin clave de OpenAI todo funciona con plantillas y la voz del navegador.

# ---- OpenAI (una sola clave cubre narración, voz y extracción) ----
OPENAI_API_KEY=                                  # sk-...  Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
OPENAI_MODEL=gpt-6-luna                          # narración + extracción (Responses API, Structured Outputs)
OPENAI_TTS_MODEL=gpt-4o-mini-tts                 # voz con la personalidad de cada perfil

# ---- Fuentes (opcional) ----
NCBI_API_KEY=                                    # sube PubMed/ClinVar de 3 a 10 req/s en la ingesta

# ---- Supabase (opcional: camino a escala y guardar conversaciones) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                       # solo servidor y scripts. NUNCA en el cliente.

# ---- Sitio ----
NEXT_PUBLIC_SITE_NAME=Atlas
NEXT_PUBLIC_GITHUB_URL=https://github.com/perdomoangelrangel-tech/7th-Hack-Nation-Global-AI-Hackathon-proyect
NEXT_PUBLIC_VIDEO_DEMO=
NEXT_PUBLIC_VIDEO_TECH=
NEXT_PUBLIC_VIDEO_TEAM=
