# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://zuqwmvshkhniqebtxlks.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...     # public, safe in the browser
SUPABASE_SERVICE_ROLE_KEY=                           # optional, server only. Never NEXT_PUBLIC_.

# ---- OpenAI (required for the challenge track: extract · reconcile · explain) ----
OPENAI_API_KEY=                                      # empty → deterministic fallback mode
OPENAI_MODEL=gpt-4o                                  # drafting / extraction
OPENAI_MODEL_FAST=gpt-4o-mini                        # reconciliation tie-breaks, short explanations

# ---- ElevenLabs (voices of the four AI agents) ----
ELEVENLABS_API_KEY=                                  # server only: /api/speak text-to-speech
NEXT_PUBLIC_ELEVENLABS_AGENT_PATIENT=                # devon
NEXT_PUBLIC_ELEVENLABS_AGENT_FAMILY=                 # maria
NEXT_PUBLIC_ELEVENLABS_AGENT_RESEARCHER=             # osei
NEXT_PUBLIC_ELEVENLABS_AGENT_PHARMA=                 # priya
ATLAS_TOOLS_KEY=                                     # header x-atlas-key that ElevenLabs sends to /api/tools/*

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/perdomoangelrangel-tech/7th-Hack-Nation-Global-AI-Hackathon-proyect
