# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...        # solo servidor y scripts de ingesta. NUNCA en el cliente.

# ---- Modelos (créditos del hackathon) ----
OPENAI_API_KEY=                                  # sin clave, /api/ask corre en modo demo determinista
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=                               # opcional, para extracción en la ingesta

# ---- ElevenLabs Agents ----
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_FAMILY=
ELEVENLABS_AGENT_CLINICAL=
ELEVENLABS_AGENT_RESEARCH=
ATLAS_TOOLS_KEY=                                 # header x-atlas-key que ElevenLabs manda a /api/tools/*

# ---- Fuentes ----
NCBI_API_KEY=                                    # opcional: sube PubMed/ClinVar de 3 a 10 req/s

# ---- Sitio ----
NEXT_PUBLIC_SITE_NAME=Atlas
NEXT_PUBLIC_GITHUB_URL=https://github.com/perdomoangelrangel-tech/7th-Hack-Nation-Global-AI-Hackathon-proyect
NEXT_PUBLIC_VIDEO_DEMO=
NEXT_PUBLIC_VIDEO_TECH=
NEXT_PUBLIC_VIDEO_TEAM=
